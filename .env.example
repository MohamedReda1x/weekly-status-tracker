# Copy to .env. Never commit .env.
POSTGRES_PASSWORD=change-me-long-random
APP_URL=http://localhost:8000
# First admin, created at startup if no user exists
ADMIN_EMAIL=manager@example.com
ADMIN_PASSWORD=ChangeMe-12345
# true only behind HTTPS (production). With false the session cookie has no "Secure" flag (needed for http://localhost).
COOKIE_SECURE=false
# "console" = test mode (mails stored in Accounts > Outbox, never sent); "resend" = real sending via Resend HTTPS API
EMAIL_MODE=console
RESEND_API_KEY=
MAIL_FROM=Weekly Tracker <no-reply@your-domain.com>
# Only for running without Docker (start-local.ps1)
DATABASE_URL=postgresql://tracker:change-me-long-random@localhost:5432/tracker
